{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build Java",
      "type": "shell",
      "command": "javac",
      "args": ["-d", "bin", "src\\Main.java"],
      "group": "build"
    },
    {
      "label": "Run Java",
      "type": "shell",
      "command": "java",
      "args": ["-cp", "bin", "Main"],
      "dependsOn": "Build Java",
      "group": "test"
    }
  ]
}
